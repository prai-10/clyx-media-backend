# Copy to .env for local dev. On Render, set these in the service's Environment tab.

# Supabase -> Connect -> Transaction pooler (port 6543). Percent-encode special chars in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API. Service-role key must never reach the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=site-images

# Admin panel login and token signing. Use a long random JWT_SECRET (32+ bytes) and a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=

PORT=3000
# Comma-separated allowed frontend origins, e.g. https://your-site.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Careers apply form -> emails the resume to CAREERS_TO_EMAIL via Resend (https://resend.com).
# Verify clyxmedia.com in Resend (Domains) so MAIL_FROM can use it.
RESEND_API_KEY=
MAIL_FROM=Clyx Careers <careers@clyxmedia.com>
CAREERS_TO_EMAIL=HR Clyx <hr@clyxmedia.com>
# Contact page enquiry form -> emailed to CONTACT_TO_EMAIL with the same Resend key.
CONTACT_FROM=Clyx Website <website@clyxmedia.com>
CONTACT_TO_EMAIL=Clyx <work@clyxmedia.com>
