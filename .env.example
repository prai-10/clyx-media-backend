# Copy to .env for local dev. On Render, set these in the service's Environment tab.

# Supabase -> Connect -> Transaction pooler (port 6543). Percent-encode special chars in the password (@ -> %40).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase -> Project Settings -> API. Service-role key must never reach the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=site-images

# Admin panel login and token signing. Use a long random JWT_SECRET (32+ bytes) and a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
JWT_SECRET=

PORT=3000
# Comma-separated allowed frontend origins, e.g. https://your-site.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Careers apply form -> emails the resume to CAREERS_TO_EMAIL via Resend (https://resend.com),
# and sends the candidate a confirmation from CAREERS_TO_EMAIL.
# Verify clyxmedia.com in Resend (Domains) so these addresses can send.
RESEND_API_KEY=
MAIL_FROM=Clyx Careers <hr@clyxmedia.com>
CAREERS_TO_EMAIL=CLYX Media Careers <hr@clyxmedia.com>
# Contact form + newsletter -> team notice to CONTACT_TO_EMAIL (sent from CONTACT_FROM);
# the visitor's acknowledgement / welcome email is sent from CONTACT_TO_EMAIL.
CONTACT_FROM=Clyx Website <work@clyxmedia.com>
CONTACT_TO_EMAIL=CLYX Media <work@clyxmedia.com>
